diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
index dbe13c5..ac86b6e 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
@@ -9,6 +9,16 @@ board=$(board_name)
 case "$FIRMWARE" in
 "ath11k/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin")
 	case "$board" in
+	mercusys,mr80x-v2)
+		# 0:art holds no MAC and the caldata only carries the 00:03:7f Atheros
+		# placeholder, so derive one from the label MAC. Verified on hardware:
+		# get_mac_label_dt returns 08:8a:f1:39:98:c0. If it ever returns empty,
+		# the garbage lands at caldata offset 0xe and the firmware asserts in
+		# phyrf_bdf.c:605 - check the alias is a path string, not a phandle.
+		caldata_extract "0:art" 0x1000 0x20000
+		ath11k_patch_mac $(macaddr_add $(get_mac_label_dt) 2) 0
+		ath11k_set_macflag
+		;;
 	cmcc,mr3000d-ci)
 		caldata_extract "0:art" 0x1000 0x20000
 		wlan_mac=$(mtd_get_mac_binary 0:art 12)
@@ -63,6 +73,16 @@ case "$FIRMWARE" in
 	;;
 "ath11k/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin")
 	case "$board" in
+	mercusys,mr80x-v2)
+		# 0:art holds no MAC and the caldata only carries the 00:03:7f Atheros
+		# placeholder, so derive one from the label MAC. Verified on hardware:
+		# get_mac_label_dt returns 08:8a:f1:39:98:c0. If it ever returns empty,
+		# the garbage lands at caldata offset 0xe and the firmware asserts in
+		# phyrf_bdf.c:605 - check the alias is a path string, not a phandle.
+		caldata_extract "0:art" 0x26800 0x20000
+		ath11k_patch_mac $(macaddr_add $(get_mac_label_dt) 3) 0
+		ath11k_set_macflag
+		;;
 	cmcc,mr3000d-ci)
 		caldata_extract "0:art" 0x26800 0x20000
 		wlan_mac=$(mtd_get_mac_binary 0:art 18)
