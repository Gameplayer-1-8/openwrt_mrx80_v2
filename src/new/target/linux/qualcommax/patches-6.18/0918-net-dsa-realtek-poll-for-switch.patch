From: OpenWrt MR3000X port <local>
Subject: net: dsa: realtek: poll for the switch instead of failing the first read

On the Mercusys MR3000X the RTL8367S does not answer on MDIO when the driver
probes early in a NAND boot (~3.7 s after reset): the reads come back all-ones
and probe fails with -ENODEV. The much slower initramfs path (~11 s) finds the
chip immediately, and an unbind/rebind at runtime always succeeds. The reset
GPIO handling is identical in all three cases, so a fixed extra delay would be
guesswork. Poll for up to 15 s instead and log how long it really took.
---
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -3220,6 +3220,10 @@
 	return 0;
 }
 
+/* Poll for the switch instead of giving up on the first read - see rtl8365mb_detect() */
+#define RTL8365MB_DETECT_TRIES		60
+#define RTL8365MB_DETECT_DELAY_MS	250
+
 static int rtl8365mb_detect(struct realtek_priv *priv)
 {
 	struct rtl8365mb *mb = priv->chip_data;
@@ -3227,30 +3231,50 @@
 	u32 chip_ver;
 	int ret;
 	int i;
+	int try;
 
-	ret = rtl8365mb_get_chip_id_and_ver(priv->map, &chip_id, &chip_ver);
-	if (ret) {
-		dev_err(priv->dev, "failed to read chip id and version: %pe\n",
-			ERR_PTR(ret));
-		return ret;
-	}
+	/* On some boards the switch is not answering yet when the driver probes:
+	 * booting from NAND reaches this point around 3.7 s after reset and the
+	 * MDIO reads come back all-ones, while the much slower initramfs path
+	 * (~11 s) finds the chip immediately. The delay around the reset GPIO is
+	 * identical in both cases, so waiting a fixed amount would be guesswork.
+	 * Poll instead, and report how long it actually took.
+	 */
+	for (try = 0; try < RTL8365MB_DETECT_TRIES; try++) {
+		ret = rtl8365mb_get_chip_id_and_ver(priv->map, &chip_id, &chip_ver);
+		if (ret) {
+			dev_err(priv->dev, "failed to read chip id and version: %pe\n",
+				ERR_PTR(ret));
+			return ret;
+		}
 
-	for (i = 0; i < ARRAY_SIZE(rtl8365mb_chip_infos); i++) {
-		const struct rtl8365mb_chip_info *ci = &rtl8365mb_chip_infos[i];
+		for (i = 0; i < ARRAY_SIZE(rtl8365mb_chip_infos); i++) {
+			const struct rtl8365mb_chip_info *ci = &rtl8365mb_chip_infos[i];
 
-		if (ci->chip_id == chip_id && ci->chip_ver == chip_ver) {
-			mb->chip_info = ci;
-			break;
+			if (ci->chip_id == chip_id && ci->chip_ver == chip_ver) {
+				mb->chip_info = ci;
+				break;
+			}
 		}
+
+		if (mb->chip_info)
+			break;
+
+		msleep(RTL8365MB_DETECT_DELAY_MS);
 	}
 
 	if (!mb->chip_info) {
 		dev_err(priv->dev,
-			"unrecognized switch (id=0x%04x, ver=0x%04x)", chip_id,
-			chip_ver);
+			"unrecognized switch (id=0x%04x, ver=0x%04x) after %d ms",
+			chip_id, chip_ver,
+			RTL8365MB_DETECT_TRIES * RTL8365MB_DETECT_DELAY_MS);
 		return -ENODEV;
 	}
 
+	if (try)
+		dev_info(priv->dev, "switch answered after %d ms\n",
+			 try * RTL8365MB_DETECT_DELAY_MS);
+
 	dev_info(priv->dev, "found an %s switch\n", mb->chip_info->name);
 
 	priv->num_ports = RTL8365MB_MAX_NUM_PORTS;
