#!/bin/sh
# The Mercusys MR80X v2 keeps its factory data, including the 6-byte raw
# "default-mac", in the tp_data UBIFS volume. 0:art carries no usable MAC on
# this board, U-Boot itself reports "MAC Address from ART is not valid".
#
# Attach and mount the volume read-only during preinit so board.d/02_network
# and the ath11k caldata hotplug can both read the MAC without each having to
# attach it themselves.

. /lib/functions.sh

preinit_mount_tp_data() {
	case "$(board_name)" in
	mercusys,mr80x-v2) ;;
	*) return ;;
	esac

	# ubiattach lives in /usr/sbin, which the preinit PATH omits
	local PATH="/usr/sbin:/usr/bin:$PATH"
	local mtd_num ubi_num

	[ -d /tmp/tp_data ] && return

	mtd_num=$(find_mtd_index tp_data)
	[ -n "$mtd_num" ] || return

	ubi_num=$(ubiattach -m "$mtd_num" 2>/dev/null | \
		sed -n 's/.*device number \([0-9]*\).*/\1/p')
	[ -n "$ubi_num" ] || return

	mkdir -p /tmp/tp_data
	mount -t ubifs -o ro "ubi${ubi_num}:tp_data" /tmp/tp_data 2>/dev/null
}

boot_hook_add preinit_main preinit_mount_tp_data
